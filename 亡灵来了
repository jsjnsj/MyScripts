workspace.DescendantRemoving:Connect(removeESP)

task.spawn(function()
    while true do
        task.wait(3)
        pcall(findTarget, workspace)
    end
end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        for target, t in pairs(targets) do
            if not target or not target.Parent then
                removeESP(target)
                continue
            end

            local visible = espEnabled and currentTargets[target.Name] == true
            if root and visible then
                local pos = getPosition(target)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    visible = dist <= MAX_DIST
                else
                    visible = false
                end
            end

            t.highlight.Enabled = visible
            if t.nameTag then t.nameTag.Enabled = visible end
        end
    end)
end)
