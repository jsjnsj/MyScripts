--清理旧ESP
local oldEspFolder = workspace:FindFirstChild("ESP_Folder")
if oldEspFolder then oldEspFolder:Destroy() end

local container = Instance.new("Folder")
container.Name = "ESP_Folder"
container.Parent = workspace

local TARGET_NAMES = {
    Zombie = true,
    ["Crawler"] = true,
    ["Hazard"] = true,
    ["Boomer"] = true,
    ["Charger"] = true,
    ["Tank"] = true,
}

local DISPLAY_NAMES = {
    Zombie = "僵尸",
    ["Crawler"] = "爬行者",
    ["Hazard"] = "危险者",
    ["Boomer"] = "轰炸者",
    ["Charger"] = "冲锋者",
    ["Tank"] = "坦克",
}

local NAME_TO_TARGET = {}
for targetName, displayName in pairs(DISPLAY_NAMES) do
    NAME_TO_TARGET[displayName] = targetName
end

local espEnabled = false
local currentTargets = {}
local currentColor = Color3.fromRGB(255, 200, 60)
local MAX_DIST = math.huge
local targets = {}

local function getHeadPart(model)
    if not model or not model:IsA("Model") then return nil end
    return model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
end

local function isValidTarget(obj)
    return TARGET_NAMES[obj.Name] ~= nil and obj:IsA("Model")
end

local function createNameTag(targetModel)
    local headPart = getHeadPart(targetModel)
    if not headPart then return nil end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_NameTag"
    billboard.Adornee = headPart
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = espEnabled and currentTargets[targetModel.Name] == true
    billboard.Parent = LocalPlayer.PlayerGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = DISPLAY_NAMES[targetModel.Name] or targetModel.Name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0
    label.Parent = billboard
    return billboard
end

local function addESP(target)
    if targets[target] then
        targets[target].highlight.FillColor = currentColor
        return
    end
    local hl = Instance.new("Highlight")
    hl.Adornee = target
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = currentColor
    hl.FillTransparency = 0.6
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0.2
    hl.Enabled = espEnabled and currentTargets[target.Name] == true
    hl.Parent = container

    local tag = createNameTag(target)
    targets[target] = { highlight = hl, nameTag = tag }
end

local function removeESP(obj)
    if isValidTarget(obj) then
        local t = targets[obj]
        if t then
            if t.highlight then t.highlight:Destroy() end
            if t.nameTag then t.nameTag:Destroy() end
            targets[obj] = nil
        end
    end
end

local function findTarget(parent)
    pcall(function()
        for _, obj in ipairs(parent:GetChildren()) do
            if isValidTarget(obj) then
                addESP(obj)
            end
            findTarget(obj)
        end
    end)
end

local function getPosition(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot().Position end)
        if ok then return pivot end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position end
        return nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local function refreshESP()
    for target, t in pairs(targets) do
        local visible = espEnabled and currentTargets[target.Name] == true
        t.highlight.Enabled = visible
        if t.nameTag then t.nameTag.Enabled = visible end
    end
end

