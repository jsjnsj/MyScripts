local function AddScriptButton(section, name, url)
    section:Button(name, function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        if success then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "加载成功", Text = name .. " 已加载", Duration = 2
            })
        else
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "加载失败", Text = name .. " 加载出错", Duration = 2
            })
        end
    end)
end

local function getPlayerList()
    local list = {}
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= game.Players.LocalPlayer then table.insert(list, p.Name) end
    end
    return list
end

