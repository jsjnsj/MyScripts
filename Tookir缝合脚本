Toggle(Tab2, "自瞄（更新）", false, function(on)
    -- 清理旧连接
    if _G.aimLoop then
        _G.aimLoop:Disconnect()
        _G.aimLoop = nil
    end
    if not on then return end   -- 关开关直接停

    local cam = workspace.CurrentCamera
    local lp  = game:GetService("Players").LocalPlayer
    local rs  = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")

    local SMOOTH = 0.08
    local OFFSET = Vector3.new(0, 0.2, 0)

    -- 取最近且可见的玩家头部
    local function getTarget()
        local tgt, minDot = nil, -math.huge
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            if p ~= lp and p.Character and p.Character:FindFirstChild("Head") then
                local head = p.Character.Head
                local dir = (head.Position - cam.CFrame.Position).Unit
                local dot = cam.CFrame.LookVector:Dot(dir)
                if dot > minDot then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterDescendantsInstances = {lp.Character}
                    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                    local offset = 0
                    local result
                    repeat
                        result = workspace:Raycast(cam.CFrame.Position, dir * 5000 + Vector3.new(0, offset, 0), rayParams)
                        offset = offset + 2
                    until not result or result.Instance == head or offset > 10
                    if result and result.Instance == head then
                        tgt = head
                        minDot = dot
                    end
                end
            end
        end
        return tgt
    end

    -- 主循环：随时都在锁（不需要按鼠标）
    _G.aimLoop = rs.RenderStepped:Connect(function()
        local t = getTarget()
        if t then
            local goalCF = CFrame.lookAt(cam.CFrame.Position, t.Position + OFFSET)
            cam.CFrame = cam.CFrame:Lerp(goalCF, SMOOTH)
        end
    end)

    Toast("全图自瞄已开启（无距）", "success")
end)

